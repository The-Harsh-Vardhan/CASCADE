# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# uv
.uv/
uv.lock

# Environment
.env
.env.local
.env.*.local

# Neo4j
neo4j/data/
neo4j/logs/
neo4j/import/
neo4j/plugins/

# Crawl / pipeline data (large, generated)
data/crawl/
data/code/
data/requirements/
data/reports/
data/repos/
data/graph/
data/browser_context/

# Keep data directory structure but not contents
!data/.gitkeep
!data/crawl/.gitkeep
!data/crawl/fixtures/
!data/code/.gitkeep
!data/requirements/.gitkeep
!data/reports/.gitkeep

# Playwright
playwright/.auth/
playwright-report/
test-results/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Secrets / credentials
*.pem
*.key
credentials.json
token.json

# Archive docs (too large for git, keep locally)
docs/archives/
docs/deep research/

# Compiled assets
*.pyc
*.pyo

# Root-level scratch / temp files
scratch_test.js
tmp_pr*.json
graph.html
*.tmp

# outputs/ — generated by run.py (gitignore contents, keep structure)
outputs/reports/
!outputs/reports/.gitkeep
outputs/crawl/
!outputs/crawl/.gitkeep
outputs/requirements/
!outputs/requirements/.gitkeep

# AI coding assistant config (internal dev tooling — not for evaluators)
AGENTS.md
.agents/

# Internal docs — dev process artifacts (not deliverables)
# Files stay on disk locally; not tracked in git
docs/archives/
docs/deep research/
docs/audits/
docs/implementation_plans/
docs/walkthroughs/
docs/skills and workflows/
