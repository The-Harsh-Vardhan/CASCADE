# === Google Gemini ===
# Get API keys from https://aistudio.google.com/app/apikey (free tier)
# Multiple project keys increase daily quota headroom.
# At minimum, GEMINI_API_KEY_1 is required.
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...   # optional — second project key
GEMINI_API_KEY_3=AIza...   # optional
GEMINI_API_KEY_4=AIza...   # optional
GEMINI_API_KEY_5=AIza...   # optional
GEMINI_MODEL=gemini-2.5-flash

# === GitHub ===
GITHUB_TOKEN=ghp_...
GITHUB_REPO=documenso/documenso
PR_NUMBER=0                        # Set before running Phase 3

# === Documenso Auth (for authenticated crawl) ===
DOCUMENSO_EMAIL=your@email.com
DOCUMENSO_PASSWORD=yourpassword
DOCUMENSO_BASE_URL=https://app.documenso.com

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password            # Change this

# === Pipeline settings ===
LOG_LEVEL=INFO
DATA_DIR=data
REPO_CLONE_DIR=data/repos/documenso

# === Fixture mode (skip live crawl) ===
# Set to true to use pre-committed page snapshots from data/crawl/fixtures/
# instead of live-crawling app.documenso.com. Useful when you don't have
# a Documenso account or the live site is unavailable.
CRAWL_USE_FIXTURE=false
