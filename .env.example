# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password            # Change this

# === Pipeline settings ===
LOG_LEVEL=INFO
DATA_DIR=data
REPO_CLONE_DIR=data/repos/documenso
